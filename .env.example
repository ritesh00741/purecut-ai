# ==============================================================================
# PureCut AI Environment Variables
# ==============================================================================

# Supabase Authentication & PostgreSQL Database
# Retrieve these from your Supabase Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-public-key-here

# Supabase Service Role Key (Keep private, never expose to client!)
SUPABASE_SERVICE_ROLE_KEY=your-service-role-secret-key-here

# Application Configuration
NEXT_PUBLIC_APP_URL=http://localhost:3000
NEXT_PUBLIC_APP_NAME="PureCut AI"

# Optional Cloudflare / Remove.bg API key fallback if you want server-side ML processing
# REMOVE_BG_API_KEY=your_key_here

# Google Gemini API Key (optional for Gemini Vision subject tagging & AI background generation)
# GEMINI_API_KEY=your_gemini_api_key_here
